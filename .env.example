# Este arquivo será expandido apenas quando os loops correspondentes forem implementados.
# Não armazenar segredos reais no Git.

NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Server-only Next.js: internal API origin; never use a NEXT_PUBLIC variable.
API_INTERNAL_URL=http://127.0.0.1:3001

# Infraestrutura local: copie para .env e substitua os valores.
POSTGRES_USER=portal_fumep
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portal_fumep
DATABASE_URL=postgresql://portal_fumep:change-me@127.0.0.1:5432/portal_fumep
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379
MINIO_ROOT_USER=portal_fumep
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
# Credenciais restritas ao bucket da aplicação; não use a conta root fora do bootstrap local.
MINIO_ACCESS_KEY=change-me-app-user
MINIO_SECRET_KEY=change-me-app-secret
MINIO_SECURE=false
